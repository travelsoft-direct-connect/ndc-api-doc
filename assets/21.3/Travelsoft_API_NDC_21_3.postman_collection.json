      "name": "login local",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var data = xml2Json(responseBody);",
              "pm.environment.set(\"auth_token\", data[\"S:Envelope\"][\"S:Body\"][\"ns2:LoginRS\"][\"ns2:AuthToken\"][\"ns2:Value\"]);",
              "console.log(pm.environment)"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
