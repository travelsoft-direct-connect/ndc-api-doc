    {
      "name": "AirShopping local",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var data = xml2Json(pm.response.text());\r",
              "var choiceOffer = data[\"ns2:IATA_AirShoppingRS\"][\"ns2:Response\"][\"OffersGroup\"][\"CarrierOffers\"][\"Offer\"][0];\r",
              "var choiceOffer2 = data[\"ns2:IATA_AirShoppingRS\"][\"ns2:Response\"][\"OffersGroup\"][\"CarrierOffers\"][\"Offer\"][1];\r",
              "if (pm.collectionVariables.get(\"isSwitch\") == \"true\") {\r",
              "    var obj = data[\"ns2:IATA_AirShoppingRS\"][\"ns2:Response\"][\"OffersGroup\"][\"CarrierOffers\"][\"Offer\"];\r",
              "    for(var key in obj){\r",
              "        if (obj[key].OwnerCode == pm.collectionVariables.get(\"switchChoice\")){\r",
              "            choiceOffer = obj[key];\r",
              "        }\r",
              "    }\r",
              "}\r",
              "\r",
              "pm.environment.set(\"offer-id\", choiceOffer.OfferID);\r",
              "pm.environment.set(\"offer-id-2\", choiceOffer2.OfferID);\r",
              "var offerItems = choiceOffer.OfferItem;\r",
              "if (Array.isArray(offerItems)) {\r",
              "    var items = offerItems.map((i) => i[\"OfferItemID\"]).join(\"\")\r",
              "    pm.environment.set(\"offer-items\", items);\r",
              "} else {\r",
              "    pm.environment.set(\"offer-items\", offerItems[\"OfferItemID\"]);\r",
              "}\r",
              "var offerItems2 = choiceOffer2.OfferItem;\r",
              "if (Array.isArray(offerItems2)) {\r",
              "    var items2 = offerItems.map((i) => i[\"OfferItemID\"]).join(\"\")\r",
              "    pm.environment.set(\"offer-items-2\", items2);\r",
              "} else {\r",
              "    pm.environment.set(\"offer-items-2\", offerItems2[\"OfferItemID\"]);\r",
              "}\r",
              "pm.environment.set(\"owner-code\", choiceOffer.OwnerCode);\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
