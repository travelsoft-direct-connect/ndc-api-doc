	<xs:simpleType name="ServiceBookingStatusCodeType">
		<xs:annotation>
			<xs:documentation>Represents the current status of a service item</xs:documentation>
		</xs:annotation>
		<xs:restriction base="ServiceBookingStatusContentType"/>
	</xs:simpleType>
	<xs:simpleType name="ServiceBookingStatusContentType">
		<xs:annotation>
			<xs:documentation>shows the possible statuses of a service item</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:enumeration value="CONFIRMED">
				<xs:annotation>
					<xs:documentation>Inventory owner confirms he is able to provide the Service.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="REQUESTED">
				<xs:annotation>
					<xs:documentation>OM requests the Service from the Inventory owner.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ServiceDeliveryStatusCodeType">
		<xs:annotation>
			<xs:documentation>Represents the current status of a service item</xs:documentation>
		</xs:annotation>
		<xs:restriction base="ServiceDeliveryStatusContentType"/>
	</xs:simpleType>
	<xs:simpleType name="ServiceDeliveryStatusContentType">
		<xs:annotation>
			<xs:documentation>shows the possible statuses of a service item</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:enumeration value="DELIVERED">
				<xs:annotation>
					<xs:documentation>Service has been successfully delivered.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EXPIRED">
				<xs:annotation>
					<xs:documentation>Service is no longer available for delivery. Service purchased with an associated time limit for consumption and Service was never claimed. Service having been at least Confirmed is no longer available as the Customer did not claim the Service within a specific time period, as dictated by the Airline.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FAILED TO DELIVER">
				<xs:annotation>
					<xs:documentation>Service could not be delivered due to AirlineÂ´s or provider limitations.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="IN PROGRESS">
				<xs:annotation>
					<xs:documentation>The DP is in the process of delivering the Service. There is a universal concept that the 'In progress' status may block any further financial transactions; e.g. refund</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NOT CLAIMED">
				<xs:annotation>
					<xs:documentation>The Service has not been claimed by the Passenger for reasons as a result of Passenger action or inaction. e.g. Passenger no-show, etc.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="READY TO DELIVER">
				<xs:annotation>
					<xs:documentation>Provider is in a position to start delivery of the Service.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="READY TO PROCEED">
				<xs:annotation>
					<xs:documentation>OM is in a position to allow a DP to prepare the Service. Customer is entitled to receive the Service. This is typically a trigger for ORA to begin accounting process.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="REMOVED">
				<xs:annotation>
					<xs:documentation>Service was deleted.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUSPENDED">
				<xs:annotation>
					<xs:documentation>Delivery of the Service is suspended as a result of an Airline decision.  Can only revert back to the previous status. Exception is that Suspended may go to Removed.  This status may be used in case of fraud detection.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNABLE TO DELIVER">
				<xs:annotation>
					<xs:documentation>It is not possible for the DP to deliver a Service. This could be for reasons of availability, legal or regulatory constraint.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="ServiceType">
		<xs:annotation>
			<xs:documentation>The instance of a specific flight or Service Definition as it has been offered (and eventually ordered and consumed) in the context of a specific Offer and/or Order.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="BookingStatusCode" type="ServiceBookingStatusCodeType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Indicates the current status of a Service booking.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DeliveryStatusCode" type="ServiceDeliveryStatusCodeType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Indicates the current status of a Service delivery</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DescText" type="TextType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Free text for textual description.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InventoryGuaranteeDateTime" type="DateTimeType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>The length of time inventory against a given Service is guaranteed. If inventory is not guaranteed, the Order creation (or change) may fail. In the absence of a time limit, no inventory is guaranteed.   Notes:  The presence of an inventory guarantee does not assume a guarantee of price. For the price to be guaranteed against a given Offer Item, the Price Guarantee Time Limit must also be present.  The assumption is that inventory is held when an Order is created (or changed), so this time limit only applies in the context of an Offer.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ServiceID" type="ID_Type" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Uniquely Identifies a Service within the context of one message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UnchangedInd" type="IndType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Indicated that this service is unchanged after reshopping.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ValidatingCarrier" type="CarrierType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>The organization which carries the passenger, baggage, or goods, and/or commits to delivering the carriage as well as any related services such as issuance of ticket, creation of Order, etc.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
